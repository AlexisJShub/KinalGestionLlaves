<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.kinalllaves.controller.UsuariosController" styleClass="page-root">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18" styleClass="topbar, module-topbar">
            <VBox spacing="3">
                <Label text="Usuarios" styleClass="screen-title, module-title"/>
                <Label text="Agrega usuarios y elige su rol." styleClass="hint"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Volver" onAction="#volver" styleClass="outline-btn"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="14" styleClass="page-content, module-content">
            <HBox spacing="14" alignment="CENTER_LEFT" styleClass="panel, module-panel">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Buscar usuario" styleClass="section-title"/>
                    <Label fx:id="lblAyuda" text="Elige un usuario para editarlo." styleClass="hint" wrapText="true"/>
                </VBox>
                <TextField fx:id="buscar" prefWidth="290" promptText="Nombre, código o estado" onAction="#buscar"/>
                <Button text="Buscar" onAction="#buscar" styleClass="outline-btn"/>
                <Button text="Actualizar" onAction="#buscar" styleClass="outline-btn"/>
            </HBox>
            <SplitPane dividerPositions="0.55" VBox.vgrow="ALWAYS" styleClass="workspace-split" minHeight="0">
                <items>
                    <VBox spacing="7" styleClass="panel, module-panel,compact-form" minWidth="260">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Lista de usuarios" styleClass="section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblEstadoLista" text="Cargando..." styleClass="hint"/>
                        </HBox>
                        <TableView styleClass="data-table" fx:id="tabla" VBox.vgrow="ALWAYS"/>
                    </VBox>
                    <VBox spacing="6" styleClass="panel, module-panel,compact-form" minWidth="260">
                        <Label text="Datos del usuario" styleClass="section-title"/>
                        <Label text="Llena los datos del usuario." styleClass="hint" wrapText="true"/>
                        <GridPane fx:id="formulario" hgap="9" vgap="5"/>
                        <Separator/>
                        <HBox spacing="7" alignment="CENTER_LEFT" styleClass="form-actions-bar">
                            <Button fx:id="btnGuardar" text="Guardar" onAction="#guardar" styleClass="primary-btn" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            <Button text="Nuevo usuario" onAction="#limpiar" styleClass="outline-btn" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnDesactivar" text="Desactivar usuario" onAction="#desactivar" styleClass="danger-btn" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>
                </items>
            </SplitPane>
        </VBox>
    </center>
</BorderPane>
